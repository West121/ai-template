<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hentor.oa</groupId>
        <artifactId>oa-server</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>oa-module-office</artifactId>
    <name>oa-module-office</name>
    <description>OA business domain: approval workflow sample</description>

    <dependencies>
        <dependency>
            <groupId>com.hentor.oa</groupId>
            <artifactId>oa-common</artifactId>
        </dependency>
        <!-- system 作为基础域（部门/用户/权限），业务模块允许单向依赖 system；禁止 system 反向依赖业务模块 -->
        <dependency>
            <groupId>com.hentor.oa</groupId>
            <artifactId>oa-module-system</artifactId>
        </dependency>
        <!-- @PreAuthorize 注解 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          引擎收口：office 不再直依赖 Flowable，起流程/办理/查活动一律经 oa-module-workflow 的
          WfEngineFacade（引擎层作基础层，office→workflow 单向合规；workflow 不得反向依赖业务模块）。
          守护：workflow 侧 BusinessModuleEngineImportGuardTest 断言 office/system 源码零 org.flowable import。
        -->
        <dependency>
            <groupId>com.hentor.oa</groupId>
            <artifactId>oa-module-workflow</artifactId>
        </dependency>
        <!--
          Aviator：单据模板「计算配置」(bizdoc-design.md §12) 的 computed 公式安全求值。
          共享基础设施（表达式引擎库，非 oa-module-workflow 业务模块）——同 Flowable 引擎口径，
          不违反「业务模块互不依赖」；office 自持一个沙箱化 AviatorEvaluatorInstance（BizDocCalcService）。
        -->
        <dependency>
            <groupId>com.googlecode.aviator</groupId>
            <artifactId>aviator</artifactId>
        </dependency>
    </dependencies>
</project>
