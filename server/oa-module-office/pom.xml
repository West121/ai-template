<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xingchen.oa</groupId>
        <artifactId>oa-server</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>oa-module-office</artifactId>
    <name>oa-module-office</name>
    <description>OA business domain: approval workflow sample</description>

    <dependencies>
        <dependency>
            <groupId>com.xingchen.oa</groupId>
            <artifactId>oa-common</artifactId>
        </dependency>
        <!-- system 作为基础域（部门/用户/权限），业务模块允许单向依赖 system；禁止 system 反向依赖业务模块 -->
        <dependency>
            <groupId>com.xingchen.oa</groupId>
            <artifactId>oa-module-system</artifactId>
        </dependency>
        <!-- @PreAuthorize 注解 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          中国式公文办文流程复用平台内置的 Flowable 引擎（单例 ProcessEngine 由 oa-boot 装配）。
          这里引入的是「引擎库」而非 oa-module-workflow「业务模块」——不违反「业务模块互不依赖」约束，
          等同 spring-data-jpa 之类的共享基础设施；运行时 RuntimeService/TaskService/HistoryService 由同一上下文注入。
        -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
        </dependency>
    </dependencies>
</project>
