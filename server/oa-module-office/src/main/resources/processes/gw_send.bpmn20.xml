<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://xingchen.oa/gongwen">
  <!--
    发文办理单 gw_send：拟稿(创建时) → 核稿 → 会签(可选) → 签发 → 用印 → 成文/分发。
    CODE 表单驱动；businessKey = "GW:" + documentId；assignee = ${initiator}（发起人 userId）。
    节点办理由 GongwenService 通过 TaskService 完成并回写公文（占号/用印/成文）。
  -->
  <process id="gw_send" name="发文办理单" isExecutable="true">
    <startEvent id="start"/>

    <userTask id="review" name="核稿" flowable:assignee="${initiator}"/>

    <exclusiveGateway id="gwCountersign" default="flowToIssue"/>

    <userTask id="countersign" name="会签" flowable:assignee="${initiator}"/>

    <userTask id="issue" name="签发" flowable:assignee="${initiator}"/>

    <userTask id="seal" name="用印" flowable:assignee="${initiator}"/>

    <userTask id="publish" name="成文分发" flowable:assignee="${initiator}"/>

    <endEvent id="end"/>

    <sequenceFlow id="f1" sourceRef="start" targetRef="review"/>
    <sequenceFlow id="f2" sourceRef="review" targetRef="gwCountersign"/>
    <sequenceFlow id="flowToCountersign" sourceRef="gwCountersign" targetRef="countersign">
      <conditionExpression xsi:type="tFormalExpression">${needCountersign == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowToIssue" sourceRef="gwCountersign" targetRef="issue"/>
    <sequenceFlow id="f3" sourceRef="countersign" targetRef="issue"/>
    <sequenceFlow id="f4" sourceRef="issue" targetRef="seal"/>
    <sequenceFlow id="f5" sourceRef="seal" targetRef="publish"/>
    <sequenceFlow id="f6" sourceRef="publish" targetRef="end"/>
  </process>
</definitions>
