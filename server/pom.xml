<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.1</version>
        <relativePath/>
    </parent>

    <groupId>com.xingchen.oa</groupId>
    <artifactId>oa-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>oa-server</name>
    <description>OA Platform - Spring Boot 4 modular monolith</description>

    <modules>
        <module>oa-common</module>
        <module>oa-module-infra</module>
        <module>oa-module-system</module>
        <module>oa-module-office</module>
        <module>oa-module-workflow</module>
        <module>oa-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <jjwt.version>0.12.6</jjwt.version>
        <flowable.version>8.0.0</flowable.version>
        <springdoc.version>3.0.3</springdoc.version>
        <lombok.version>1.18.42</lombok.version>
        <!-- Aviator：Tier 1 公式安全表达式引擎（可注册自定义函数、可禁反射/禁任意对象访问） -->
        <aviator.version>5.4.3</aviator.version>
        <!-- LiteFlow：Tier 2 多语言脚本执行器（N-B-00 spike 已验证 SB4/Java21；
             SB4 必须用专门坐标 liteflow-spring-boot4-starter，普通 starter 仅 SB2/3） -->
        <liteflow.version>2.16.0</liteflow.version>
        <!-- Spring AI 2（GA，SB4 基线）：AI 助手主链路 ChatClient+Advisor+ToolCallback（附1 批B/附2 裁定）。
             只引库模块（client-chat/openai），不引 starter 自动装配——凭据动态来自 orch_credential。 -->
        <spring-ai.version>2.0.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- internal modules -->
            <dependency>
                <groupId>com.xingchen.oa</groupId>
                <artifactId>oa-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xingchen.oa</groupId>
                <artifactId>oa-module-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xingchen.oa</groupId>
                <artifactId>oa-module-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xingchen.oa</groupId>
                <artifactId>oa-module-office</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xingchen.oa</groupId>
                <artifactId>oa-module-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Flowable 8（Spring Boot 4 适配；process 引擎 starter 8.0 起坐标为 flowable-spring-boot-starter-process） -->
            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-spring-boot-starter-process</artifactId>
                <version>${flowable.version}</version>
            </dependency>
            <!-- Spring AI 2 BOM（模块版本统一管理） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Aviator（Tier 1 公式引擎） -->
            <dependency>
                <groupId>com.googlecode.aviator</groupId>
                <artifactId>aviator</artifactId>
                <version>${aviator.version}</version>
            </dependency>
            <!-- LiteFlow（Tier 2 脚本引擎）：SB4 专用 starter + Groovy/GraalJS/Jython 三脚本插件。
                 我们只用其脚本执行 SPI（ScriptExecutorFactory），不用链路编排（liteflow.enable=false）。 -->
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-spring-boot4-starter</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-script-groovy</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-script-graaljs</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-script-python</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
            <!-- jjwt -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <!-- springdoc -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
